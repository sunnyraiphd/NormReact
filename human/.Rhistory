library(dplyr)
library(broom)
library(purrr)
# Suppose `models` is your filtered list:
models <- keep(models, ~ !is.null(.x$model))  # remove NULL models
# Extract tidy results for each model
model_results <- imap_dfr(models, ~ {
tidy(.x) %>%
mutate(
model_name = .y,
odds_ratio = exp(estimate)
)
})
View(models)
library(dplyr)
library(broom)
library(purrr)
library(knitr)
# Extract glm objects if nested
models_clean <- map(models, ~ if(is.list(.x) && "model" %in% names(.x)) .x$model else .x)
# Remove NULLs
models_clean <- keep(models_clean, ~ !is.null(.x))
# Extract tidy results
model_results <- imap_dfr(models_clean, ~ {
tidy(.x) %>%
mutate(
model_name = .y,
odds_ratio = exp(estimate)
)
})
# Round numbers for readability
model_results <- model_results %>%
select(model_name, term, estimate, std.error, statistic, p.value, odds_ratio) %>%
mutate(
estimate = round(estimate, 3),
std.error = round(std.error, 3),
statistic = round(statistic, 2),
p.value = signif(p.value, 3),
odds_ratio = round(odds_ratio, 2)
)
# Generate LaTeX table using knitr
knitr::kable(
model_results,
format = "latex",
booktabs = TRUE,
caption = "GLM model results for approach/avoidance reactions by emotion and social distance",
col.names = c("Model", "Term", "Estimate", "SE", "Z", "p", "Odds Ratio")
)
