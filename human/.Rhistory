"3" = "#56B4E9",
"4" = "#CC79A7",
"5" = "#F0E442"
)
# reshape data
df_long <- df %>%
pivot_longer(
cols = c(norm_inappropriateness, norm_wrongness),
names_to = "measure",
values_to = "strength"
) %>%
mutate(
measure = case_when(
measure == "norm_inappropriateness" ~ "Inappropriateness",
measure == "norm_wrongness" ~ "Wrongness",
TRUE ~ measure
),
strength = factor(as.character(as.numeric(strength)), levels = strength_order),
source = factor(source, levels = c("human", "close-source", "open-source"))
)
# calculate proportions
stats_props <- df_long %>%
count(label_type, measure, strength) %>%
group_by(label_type, measure) %>%
mutate(prop = n / sum(n)) %>%
ungroup()
# plot
p_norm <- ggplot(
stats_props,
aes(x = label_type, y = prop, fill = strength, color = strength)
) +
geom_col(alpha = 0.95) +
facet_grid(
measure ~ .,
labeller = labeller(
source = function(x) gsub("-", "\n", x)
)
) +
geom_text(
aes(label = ifelse(prop >= 0.05, scales::percent(prop, accuracy = 1), "")),
position = position_stack(vjust = 0.5),
color = "black",
size = 3
) +
scale_y_continuous(labels = scales::percent_format(accuracy = 1)) +
scale_fill_manual(values = strength_cols, breaks = strength_order, drop = FALSE) +
scale_color_manual(values = strength_cols, breaks = strength_order, drop = FALSE) +
labs(
x = NULL,
y = "Rating Distribution (%)",
fill = "Rating",
color = "Rating"
) +
theme_minimal(base_size = 16) +
theme(
axis.text.x = element_text(size = 14),
axis.text.y = element_text(size = 14),
axis.title.x = element_text(size = 16, face = "bold"),
axis.title.y = element_text(size = 16, face = "bold"),
strip.text = element_text(size = 14, face = "bold"),
legend.title = element_text(size = 14, face = "bold"),
legend.text = element_text(size = 13)
)
p_norm
ggsave(
filename = "output/p_norm.png",
plot = p_norm,
width = 7,
height = 8,
dpi = 300
)
