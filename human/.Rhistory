amount=ifelse(!is.na(amount),amount,0),
gender=factor(gender,levels=c(1,2,3,4), labels=c("Female","Male", "Non-binary","Prefer not to say")),
race = factor(race, levels=c(1,2,3,4,5,7),labels =c("White","Black or African American","Hispanic or Latino(a)","Asian","Mixed","Others"))) %>%
