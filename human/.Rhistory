reaction_var <- binary_cols[i]
# Subset data
df_sub <- df_action %>%
filter(emotion == emotion_name,
emotion_type == paste0("emotion_", soc)) %>%
droplevels()
# Skip if rater has <2 levels (prevents contrasts error)
if(length(unique(df_sub$rater)) < 2) next
# Model name
model_name <- paste0(soc, "_", emotion_name)
# Fit logistic regression
models[[model_name]] <- glm(
formula = as.formula(paste0(reaction_var, " ~ strength_value * rater")),
data = df_sub,
family = binomial
)
}
}
# -----------------------------
# Generate predicted probabilities for plotting
# -----------------------------
pred_list <- lapply(names(models), function(name) {
model <- models[[name]]
newdata <- expand.grid(
strength_value = 0:4,
rater = unique(model$data$rater)
)
# Predicted probabilities
newdata$predicted <- predict(model, newdata, type = "response")
# Confidence intervals on link scale
pred_link <- predict(model, newdata, type = "link", se.fit = TRUE)
newdata$conf.low <- plogis(pred_link$fit - 1.96 * pred_link$se.fit)
newdata$conf.high <- plogis(pred_link$fit + 1.96 * pred_link$se.fit)
newdata$outcome <- name
return(newdata)
})
# Combine all predictions
pred_combined <- bind_rows(pred_list)
pred_combined
approach <- c("Inform authority", "Inform the authorities, such as the police",
"Physical confrontation", "Verbal confrontation",
"Verbal reprimand / verbal confrontation")
avoidance <- c("Gossip", "Gossip about / discuss with / complain to others informally","Stay away","Do nothing" ,"Stay away or keep a distance from the actor","Celebrate / praise", "Praise", "Support", "Support the actor")
df_action <- df %>%
mutate(across(c(friends_reaction, strangers_reaction, acquaintances_reaction),
~ case_when(
.x %in% approach ~ "approach",
.x %in% avoidance ~ "avoidance",
TRUE ~ NA_character_
),
.names = "{.col}_category")) %>%
mutate(across(c(friends_reaction, strangers_reaction, acquaintances_reaction),
~ ifelse(.x %in% approach, 1, 0),
.names = "{.col}_binary"))
# -----------------------------
# 2. Function to fit model safely
# -----------------------------
fit_model_safe <- function(df, outcome_col) {
# Check if outcome has both 0 and 1
if(length(unique(na.omit(df[[outcome_col]]))) < 2) return(NULL)
glm(as.formula(paste0(outcome_col, " ~ strength_value * rater")),
data = df, family = binomial)
}
# -----------------------------
# 3. Fit models for all emotion x emotion_type x social distance
# -----------------------------
# Define combinations
combinations <- expand.grid(
emotion = unique(df_action$emotion),
emotion_type = unique(df_action$emotion_type),
stringsAsFactors = FALSE
)
# Fit models dynamically
models <- pmap(
combinations,
function(emotion, emotion_type) {
# Determine which column to model based on emotion_type
outcome_col <- case_when(
emotion_type == "emotion_friend" ~ "friends_reaction_binary",
emotion_type == "emotion_acquaintance" ~ "acquaintances_reaction_binary",
emotion_type == "emotion_stranger" ~ "strangers_reaction_binary"
)
df_sub <- df_action %>%
filter(emotion == !!emotion, emotion_type == !!emotion_type)
model <- fit_model_safe(df_sub, outcome_col)
list(emotion = emotion,
emotion_type = emotion_type,
model = model)
}
)
# Remove NULLs (cases with only 0 or 1)
models <- keep(models, ~ !is.null(.x$model))
# -----------------------------
# 4. Generate predicted probabilities
# -----------------------------
pred_list <- lapply(models, function(x) {
model <- x$model
if(is.null(model)) return(NULL)
newdata <- expand.grid(
strength_value = 0:4,
rater = unique(model$data$rater)
)
newdata$predicted <- predict(model, newdata, type = "response")
pred_link <- predict(model, newdata, type = "link", se.fit = TRUE)
newdata$conf.low <- plogis(pred_link$fit - 1.96 * pred_link$se.fit)
newdata$conf.high <- plogis(pred_link$fit + 1.96 * pred_link$se.fit)
newdata$emotion <- x$emotion
newdata$emotion_type <- x$emotion_type
return(newdata)
})
pred_combined <- bind_rows(pred_list)
# -----------------------------
# 5. Plot predicted probabilities dynamically
# -----------------------------
ggplot(pred_combined, aes(x = strength_value, y = predicted, color = rater, fill = rater)) +
geom_line(size = 1.2) +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high), alpha = 0.2, color = NA) +
facet_grid(emotion_type ~ emotion, scales = "free_y") +
scale_fill_manual(values = c("orange","skyblue")) +
scale_color_manual(values = c("orange","skyblue")) +
labs(
x = "Emotion Strength",
y = "Predicted Probability of Approach Reaction",
color = "Rater",
fill = "Rater"
) +
theme_classic() +
theme(strip.text = element_text(size = 8))
# -----------------------------
# 5. Plot predicted probabilities dynamically
# -----------------------------
ggplot(pred_combined, aes(x = strength_value, y = predicted, color = rater, fill = rater)) +
geom_line(size = 0.9) +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high), alpha = 0.2, color = NA) +
facet_grid(emotion_type ~ emotion, scales = "free_y") +
scale_fill_manual(values = c("orange","skyblue")) +
scale_color_manual(values = c("orange","skyblue")) +
labs(
x = "Emotion Strength",
y = "Predicted Probability of Approach Reaction",
color = "Rater",
fill = "Rater"
) +
theme_classic(base_size = 8) +  # smaller base size for two-column
theme(
strip.text = element_text(size = 6, face = "bold"), # smaller facet labels
axis.text.x = element_text(size = 6),               # smaller x-axis text
axis.text.y = element_text(size = 6),               # smaller y-axis text
axis.title = element_text(size = 7),               # smaller axis titles
legend.text = element_text(size = 6),
legend.title = element_text(size = 7),
legend.position = "bottom",
panel.spacing = unit(0.3, "lines"),               # reduce facet spacing
strip.background = element_rect(fill = "gray95")  # light background for facet labels
) +
guides(color = guide_legend(nrow = 1, byrow = TRUE),
fill = guide_legend(nrow = 1, byrow = TRUE))
