if (!require("groundhog")) install.packages("groundhog")
library("groundhog")
pkgs <- c("tidyverse","car","psych","lme4","table1","jtools","sjPlot","sjmisc","ggpubr","rstatix","lmtest","robustbase","see","rempsyc","sandwich","stargazer","boot","patchwork","data.table","irr","RColorBrewer")
groundhog.library(pkgs, "2025-08-11")
options(scipen = 999, digits = 3)
set.seed(111)
df<-read.csv( "data/df_all_long_updated.csv") %>%
mutate(rater=ifelse(label_type=="human","human","llm")) %>%
mutate(unique_id=paste0(label_type,"_",human_id))
# --- compute pairwise similarities
df_wide <- df %>%
filter(emotion_type == "emotion_actor") %>%
select(id=ID, rater, unique_id,stimuli, emotion, strength_value,emotion_type) %>%
pivot_wider(id_cols = c(unique_id,stimuli,rater),
names_from = emotion, values_from = strength_value)
pairwise_cos <- df_wide %>%
group_by(stimuli) %>%
do({
mat <- as.matrix(select(., -unique_id, -stimuli))
rownames(mat) <- .$unique_id
cos_sim <- as.matrix(proxy::simil(mat, method = "cosine"))
as.data.frame(as.table(cos_sim)) %>%
rename(unique_id_1 = Var1, unique_id_2 = Var2, cosine_similarity = Freq) %>%
filter(unique_id_1 != unique_id_2)  # remove self-comparison
}) %>%
ungroup() %>%
rowwise() %>%
mutate(pair = paste(sort(c(unique_id_1, unique_id_2)), collapse = "_")) %>%
distinct(pair, .keep_all = TRUE) %>%
select(-pair) %>%
mutate(
unique_id_1_std = ifelse(startsWith(as.character(unique_id_1), "human"), "human", as.character(unique_id_1)),
unique_id_2_std = ifelse(startsWith(as.character(unique_id_2), "human"), "human", as.character(unique_id_2))
)
pairwise_cos
# Compute average cosine similarity of each non-human ID to humans
avg_cosine_to_human <- pairwise_cos %>%
# Keep only pairs where one side is human and the other is non-human
filter(
(unique_id_1_std == "human" & unique_id_2_std != "human") |
(unique_id_2_std == "human" & unique_id_1_std != "human")
) %>%
# Identify which is the non-human ID in the pair
mutate(non_human_id = ifelse(unique_id_1_std == "human", unique_id_2_std, unique_id_1_std)) %>%
# Group by non-human ID and compute mean cosine similarity
group_by(non_human_id) %>%
summarise(avg_cosine_similarity_to_human = mean(cosine_similarity, na.rm = TRUE)) %>%
ungroup()
avg_cosine_to_human
# Step 1: Non-human → human average per stimuli × non-human
nonhuman_to_human_avg <- pairwise_cos %>%
filter((unique_id_1_std == "human" & unique_id_2_std != "human") |
(unique_id_2_std == "human" & unique_id_1_std != "human")) %>%
mutate(non_human_id = ifelse(unique_id_1_std == "human", unique_id_2_std, unique_id_1_std)) %>%
group_by(stimuli, non_human_id) %>%
summarise(
unique_id_1 = first(unique_id_1_std),
unique_id_2 = first(unique_id_2_std),
cosine_similarity = mean(cosine_similarity, na.rm = TRUE),
.groups = "drop"
) %>%
select(stimuli, unique_id_1, unique_id_2, cosine_similarity)
# Step 2: Human → human average per stimuli
human_to_human_avg <- pairwise_cos %>%
filter(unique_id_1_std == "human" & unique_id_2_std == "human") %>%
group_by(stimuli) %>%
summarise(
unique_id_1 = first(unique_id_1_std),
unique_id_2 = first(unique_id_2_std),
cosine_similarity = mean(cosine_similarity, na.rm = TRUE),
.groups = "drop"
) %>%
select(stimuli, unique_id_1, unique_id_2, cosine_similarity)
# Step 3: Non-human → non-human (keep original)
nonhuman_to_nonhuman <- pairwise_cos %>%
filter(unique_id_1_std != "human" & unique_id_2_std != "human") %>%
select(stimuli, unique_id_1 = unique_id_1_std, unique_id_2 = unique_id_2_std, cosine_similarity)
# Step 4: Combine all into a single table
final_pairwise_cos <- bind_rows(nonhuman_to_human_avg, human_to_human_avg, nonhuman_to_nonhuman)
# Optional: remove duplicates in case any exist (e.g., A–B vs B–A)
final_pairwise_cos <- final_pairwise_cos %>%
mutate(pair_id = paste(pmin(unique_id_1, unique_id_2), pmax(unique_id_1, unique_id_2), sep = "_")) %>%
distinct(stimuli, pair_id, .keep_all = TRUE) %>%
select(-pair_id)
#Compute average
avg_pairwise_cos <- final_pairwise_cos %>%
mutate(
# Put the smaller ID in unique_id_1, larger in unique_id_2
u1 = pmin(unique_id_1, unique_id_2),
u2 = pmax(unique_id_1, unique_id_2)
) %>%
# Compute average cosine similarity across stimuli
group_by(u1, u2) %>%
summarise(avg_cosine_similarity = mean(cosine_similarity, na.rm = TRUE),
.groups = "drop") %>%
# Reorder u2 so that "human" is last (at the bottom)
mutate(u2 = factor(u2, levels = c(sort(setdiff(unique(u2), "human")), "human")))
avg_pairwise_cos
# Plot heatmap with human at top
ggplot(avg_pairwise_cos, aes(x = u1, y = u2, fill = avg_cosine_similarity)) +
geom_tile(color = "white") +
scale_fill_distiller(palette = "Gn", direction = 1) +
geom_text(aes(label = round(avg_cosine_similarity, 2)), color = "black", size = 4) +
labs(
title = "Average Cosine Similarity Across Stimuli",
x = "Unique ID 1",
y = "Unique ID 2",
fill = "Avg Cosine"
) +
scale_y_discrete(limits = rev(levels(avg_pairwise_cos$u2))) +  # reverse to put top at top
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
df_analysis <- final_pairwise_cos %>%
# ensure character (important if columns are factors)
mutate(
u1 = as.character(unique_id_1),
u2 = as.character(unique_id_2)
) %>%
# create order-invariant pair id (vectorized)
mutate(
pair_model = paste(pmin(u1, u2), pmax(u1, u2), sep = "_"),
pair_type = case_when(
u1 == "human" & u2 == "human" ~ "human_human",
u1 == "human" | u2 == "human" ~ "LLM_human",
TRUE ~ "LLM_LLM"
)
) %>%
# optional: keep only human-containing pairs
filter(pair_type != "LLM_LLM") %>%
select(-u1, -u2)  %>%
mutate(
# Make "human_human" the reference level for both
pair_type = factor(pair_type, levels = c("human_human", "LLM_human")),
pair_model = factor(pair_model, levels = c("human_human", setdiff(unique(pair_model), "human_human")))
)
# overall
model<-lmer(cosine_similarity~pair_type + (1|stimuli), df_analysis)
# each model
model2<-lmer(cosine_similarity~pair_model + (1|stimuli), df_analysis)
tab_model(model,model2)
